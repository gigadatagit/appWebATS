REFLEX_HOT_RELOAD_EXCLUDE_PATHS=
APP_ENV=development
DATABASE_URL=
# Optional: build DATABASE_URL automatically from parts when DATABASE_URL is empty.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SSLMODE=require
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ATSDocumentos
# Optional override. If empty, app autodetects: linux->libreoffice, others->word.
ATS_PDF_ENGINE=
SUPABASE_SIGNED_URL_TTL_SECONDS=600

# Railway / production (container):
# APP_ENV=production
# ATS_PDF_ENGINE=libreoffice
# SUPABASE_STORAGE_BUCKET=ATSDocumentos
# DATABASE_URL is required in container runtime to avoid SQLite fallback.

# Optional: only if you need to verify JWTs manually server-side.
SUPABASE_JWT_SECRET=
SECRET_KEY=
